{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://railverdict.dev/schemas/configuration/v1.7.schema.json",
  "title": "RailVerdict Parsed Configuration v1.7",
  "description": "Versioned contract for .railverdict.yml with per-analyzer timeout_seconds and review change-intelligence policy. Version 1.7 adds an optional engineering_policy section (findings, coverage, changes, review governance). All 1.6 keys keep identical meaning.",
  "type": "object",
  "required": [
    "version",
    "mode",
    "analyzers"
  ],
  "properties": {
    "version": {
      "const": 1.7
    },
    "mode": {
      "enum": [
        "advisory",
        "no_new_debt",
        "strict"
      ]
    },
    "analyzers": {
      "$ref": "#/$defs/analyzers"
    },
    "baseline": {
      "$ref": "#/$defs/baselineConfig"
    },
    "waivers": {
      "$ref": "#/$defs/waiversConfig"
    },
    "git": {
      "$ref": "#/$defs/gitConfig"
    },
    "ai": {
      "$ref": "#/$defs/aiConfig"
    },
    "review": {
      "$ref": "#/$defs/reviewConfig"
    },
    "engineering_policy": {
      "$ref": "#/$defs/engineeringPolicy"
    }
  },
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "$defs": {
    "analyzers": {
      "type": "object",
      "required": [
        "rubocop"
      ],
      "properties": {
        "rubocop": {
          "$ref": "#/$defs/analyzerSelection"
        },
        "minitest": {
          "$ref": "#/$defs/analyzerSelection"
        },
        "rspec": {
          "$ref": "#/$defs/analyzerSelection"
        },
        "simplecov": {
          "$ref": "#/$defs/simplecovSelection"
        },
        "bundler_audit": {
          "$ref": "#/$defs/bundlerAuditSelection"
        },
        "brakeman": {
          "$ref": "#/$defs/analyzerSelection"
        }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "analyzerSelection": {
      "type": "object",
      "required": [
        "enabled",
        "required"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "required": {
          "type": "boolean"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false,
      "not": {
        "required": [
          "enabled",
          "required"
        ],
        "properties": {
          "enabled": {
            "const": false
          },
          "required": {
            "const": true
          }
        }
      }
    },
    "simplecovSelection": {
      "type": "object",
      "required": [
        "enabled",
        "required"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "required": {
          "type": "boolean"
        },
        "coverage_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "freshness_window_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2592000
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false,
      "not": {
        "required": [
          "enabled",
          "required"
        ],
        "properties": {
          "enabled": {
            "const": false
          },
          "required": {
            "const": true
          }
        }
      }
    },
    "bundlerAuditSelection": {
      "type": "object",
      "required": [
        "enabled",
        "required"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "required": {
          "type": "boolean"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false,
      "not": {
        "required": [
          "enabled",
          "required"
        ],
        "properties": {
          "enabled": {
            "const": false
          },
          "required": {
            "const": true
          }
        }
      }
    },
    "baselineConfig": {
      "type": "object",
      "required": [],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "waiversConfig": {
      "type": "object",
      "required": [],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "gitConfig": {
      "type": "object",
      "required": [],
      "properties": {
        "base": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "aiConfig": {
      "type": "object",
      "required": [],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "off",
            "explain",
            "investigate"
          ]
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "remote": {
          "$ref": "#/$defs/aiRemoteConfig"
        },
        "budgets": {
          "$ref": "#/$defs/aiBudgetsConfig"
        },
        "cache": {
          "$ref": "#/$defs/aiCacheConfig"
        }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "aiRemoteConfig": {
      "type": "object",
      "required": [],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "trust": {
          "enum": [
            "redacted",
            "full"
          ]
        },
        "endpoint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "aiBudgetsConfig": {
      "type": "object",
      "required": [],
      "properties": {
        "max_findings": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "max_requests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "max_context_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 262144
        }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "aiCacheConfig": {
      "type": "object",
      "required": [],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 104857600
        }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "reviewConfig": {
      "type": "object",
      "required": [],
      "properties": {
        "sensitive_paths": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        },
        "risk": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "additionalProperties": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          }
        }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "engineeringPolicy": {
      "type": "object",
      "required": [],
      "properties": {
        "findings": {
          "$ref": "#/$defs/policyFindings"
        },
        "coverage": {
          "$ref": "#/$defs/policyCoverage"
        },
        "changes": {
          "$ref": "#/$defs/policyChanges"
        },
        "review": {
          "$ref": "#/$defs/policyReview"
        }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false,
      "maxProperties": 4
    },
    "policyFindings": {
      "type": "object",
      "required": [],
      "properties": {
        "new_critical": {
          "enum": [
            "forbid",
            "allow"
          ]
        },
        "new_high": {
          "enum": [
            "forbid",
            "allow"
          ]
        }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false,
      "maxProperties": 2
    },
    "policyCoverage": {
      "type": "object",
      "required": [],
      "properties": {
        "changed_lines_minimum": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false,
      "maxProperties": 1
    },
    "policyChanges": {
      "type": "object",
      "required": [],
      "minProperties": 1,
      "maxProperties": 32,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "additionalProperties": {
        "type": "object",
        "required": [],
        "properties": {
          "require_analyzers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "enum": [
                "rubocop",
                "minitest",
                "rspec",
                "simplecov",
                "bundler_audit",
                "brakeman"
              ]
            }
          },
          "verification_scope": {
            "enum": [
              "full",
              "targeted"
            ]
          }
        },
        "additionalProperties": false,
        "unevaluatedProperties": false,
        "maxProperties": 2
      }
    },
    "policyReview": {
      "type": "object",
      "required": [],
      "minProperties": 1,
      "maxProperties": 32,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "human_review"
        ],
        "properties": {
          "human_review": {
            "const": "required"
          }
        },
        "additionalProperties": false,
        "unevaluatedProperties": false,
        "maxProperties": 1
      }
    }
  }
}
