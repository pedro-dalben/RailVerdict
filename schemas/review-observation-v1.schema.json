{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://railverdict.dev/schemas/review-observation/v1.schema.json",
  "title": "RailVerdict Review Observation v1",
  "description": "An outside observation about a verified state. Always non-authoritative: validates reference to a state, never correctness of the conclusion, and never alters any gate, requirement, finding, receipt, or handoff.",
  "type": "object",
  "required": [
    "schema_version",
    "observation_id",
    "author",
    "confidence",
    "authoritative",
    "state_binding",
    "observations"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "observation_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "author": { "enum": ["human", "agent", "ai"] },
    "provider": { "type": "string", "minLength": 1, "maxLength": 128 },
    "model": { "type": "string", "minLength": 1, "maxLength": 128 },
    "confidence": { "enum": ["low", "medium", "high"] },
    "authoritative": { "const": false },
    "state_binding": {
      "type": "object",
      "required": ["head", "configuration_digest", "policy_digest"],
      "properties": {
        "head": { "type": "string", "minLength": 7, "maxLength": 64 },
        "configuration_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "policy_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["summary"],
        "properties": {
          "summary": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "paths": {
            "type": "array",
            "maxItems": 16,
            "items": { "type": "string", "minLength": 1, "maxLength": 512 }
          },
          "severity": { "enum": ["info", "low", "medium", "high", "critical"] }
        },
        "additionalProperties": false,
        "unevaluatedProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "author": { "const": "human" } } },
      "then": { "properties": { "provider": false, "model": false } }
    },
    {
      "if": { "properties": { "author": { "enum": ["agent", "ai"] } } },
      "then": { "required": ["provider"] }
    }
  ],
  "additionalProperties": false,
  "unevaluatedProperties": false
}
